# Copy to .env for `docker compose up` and `npm run dev`.
# Every value here is a throwaway local default; scripts/smoke.sh uses this
# file directly, so its owner credentials are the smoke-test credentials.

# Postgres service in compose.yaml
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog

# Used by `npm run dev` against the Compose db service; the web container
# builds its own URL from the POSTGRES_* values.
DATABASE_URL=postgresql://blog:blog@127.0.0.1:5432/blog

# Owner account, created at first start when absent
OWNER_USERNAME=owner
OWNER_PASSWORD=local-owner-password

# Language that / redirects to: zh or en
SITE_DEFAULT_LANGUAGE=en
