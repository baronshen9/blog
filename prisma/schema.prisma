generator client {
  provider = "prisma-client"
  output   = "../src/server/db/generated"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  ownerId   String   @db.Uuid
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum Language {
  zh
  en
}

enum PostStatus {
  draft
  published
}

model Post {
  id                 String     @id @default(uuid()) @db.Uuid
  translationGroupId String     @default(uuid()) @db.Uuid
  language           Language
  title              String
  slug               String
  bodyMarkdown       String
  tags               String[]   @default([])
  status             PostStatus @default(draft)
  publishedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  comments           Comment[]

  @@unique([language, slug])
  @@unique([translationGroupId, language])
}

model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

enum ImageType {
  png
  jpeg
  gif
  webp
}

model Image {
  id        String    @id @db.Uuid
  type      ImageType
  byteSize  Int
  createdAt DateTime  @default(now())
}

enum CommentStatus {
  pending
  approved
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @db.Uuid
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  nickname  String
  message   String
  status    CommentStatus @default(pending)
  createdAt DateTime      @default(now())
}

// Comments a visitor submitted in one fixed window, keyed by a keyed hash of
// the visitor's address; the address itself is never stored.
model CommentRateLimit {
  visitorHash String
  windowStart DateTime
  count       Int

  @@id([visitorHash, windowStart])
}
